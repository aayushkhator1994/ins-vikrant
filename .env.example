# Vapi private key and the ID of the phone number to attach the assistant to
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Public https URL of the bridge (for example from: ngrok http 8787)
PUBLIC_URL=
# Shared secret sent by Vapi on every tool call; the bridge refuses calls without it
BRIDGE_SECRET=
# Comma-separated phone numbers allowed to launch missions, e.g. +14155551234
CALLER_ALLOWLIST=
DAILY_MISSION_CAP=20
# Optional: ntfy topic for the verdict push
NTFY_TOPIC=
PORT=8787
# Context.dev: the checker and scouts fetch pages through it when set
CONTEXT_DEV_API_KEY=
# New York Token Exchange (a TrustedRouter key): writes the captain's briefing when set
NYTE_API_KEY=
# boat.dev: scouts listed in BOAT_SCOUTS run on their own Boat VM when set
BOAT_API_KEY=
BOAT_SCOUTS=fundamentals
